#
# Образ для веб-сайта (scireason web): регистрация (email/пароль или Telegram),
# просмотр отчётов, запуск пайплайна, дашборд. Общая БД с ботом:
# если задан DATABASE_URL (Postgres) — используется он, иначе SQLite.
#
# Сайт работает офлайн по умолчанию: mock LLM, hash-эмбеддинги, без Neo4j/Qdrant.
# Модели перевода argostranslate и офлайн-детектор языка fastText предзагружаются
# на этапе сборки — как в Dockerfile.bot, чтобы запуск пайплайна с сайта совпадал.
#
# Сборка:   docker build -f Dockerfile.web -t scireason-web .
# Запуск:   docker run --rm -p 8080:8080 \
#             -e WEB_SECRET_KEY=xxx -e DATABASE_URL=postgresql://... \
#             -v "$PWD/runs:/app/runs" -v "$PWD/.cache:/app/.cache" scireason-web
# Или через docker compose (сервис web) — см. docker-compose.yml.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ARGOS_PACKAGES_DIR=/app/.cache/argos-translate \
    XDG_DATA_HOME=/app/.cache/xdg \
    # Offline-безопасные значения по умолчанию (можно переопределить через -e/.env).
    LLM_PROVIDER=mock \
    EMBED_PROVIDER=hash \
    GRAPH_BACKEND=none \
    VLM_BACKEND=none \
    OCR_BACKEND=pymupdf \
    WEB_HOST=0.0.0.0 \
    WEB_PORT=8080

WORKDIR /app

# Системные зависимости: build-essential для сборки колёс (sentencepiece и т.п.),
# libgl1/libglib2.0-0 нужны PyMuPDF/pillow при работе с изображениями.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Сначала только метаданные пакета + исходники, чтобы кэшировать слой установки.
COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts ./scripts
COPY data ./data

# Устанавливаем пакет с web-extra (fastapi/uvicorn/jinja2/bcrypt/itsdangerous/
# psycopg) и рантайм-зависимости пайплайна, идентичные боту, чтобы запуск
# пайплайна с сайта работал так же (перевод/детекция языка/PDF).
RUN python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install -e ".[web]" && \
    python -m pip install argostranslate pymupdf langdetect fasttext-wheel

# Предзагрузка моделей перевода и детектора языка (идемпотентно, офлайн-безопасно).
# По умолчанию ОТКЛЮЧЕНА: на слабых VM (2 CPU / <4 ГБ) скачивание+распаковка
# argos-пакетов вызывает OOM во время сборки. Модели скачаются лениво при первом
# запуске пайплайна (том /app/.cache сохраняет их между перезапусками).
# Включить предзагрузку в образ: docker build --build-arg PRELOAD_MODELS=1 ...
ARG PRELOAD_MODELS=0
RUN if [ "$PRELOAD_MODELS" = "1" ]; then \
        python scripts/preload_argos.py && \
        python scripts/preload_fasttext_lid.py; \
    else \
        echo "Skipping model preload (PRELOAD_MODELS=$PRELOAD_MODELS); models load lazily at first run."; \
    fi

# Тома для персистентности:
#  - /app/runs   : результаты пайплайна + SQLite (если не Postgres);
#  - /app/.cache : HTTP-кэш и модели перевода.
RUN mkdir -p /app/runs /app/.cache

EXPOSE 8080

ENTRYPOINT ["top-papers-graph"]
CMD ["web"]
